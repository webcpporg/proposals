project : requirements <library>/webcpp/asio//asio <library>/webcpp//node-test ;
import webcpp ;
webcpp.targets wasip2 ;
webcpp.run cobalt : ../cobalt_test.cpp : <library>/webcpp/asio//cobalt : wasip2 ;
webcpp.run cobalt_network : ../cobalt_network_test.cpp : <library>/webcpp/asio//cobalt : wasip2 ;
webcpp.run cobalt_io : ../cobalt_io_test.cpp : <library>/webcpp/asio//cobalt : wasip2 ;
webcpp.run cobalt_accept_cancel : ../cobalt_accept_cancel_test.cpp
  : <library>/webcpp/asio//cobalt : wasip2 ;
webcpp.run cobalt_cancel : cobalt_cancel.cpp : <library>/webcpp/asio//cobalt : wasip2 ;
webcpp.original python3 : ../wasip2 ;
webcpp.drive entropy : ../../../../tools/openssl/test/entropy.c
  : <library>/webcpp/third_party//openssl <linkflags>-Wl,--wrap=getentropy
  : entropy_driver.py : : wasip2 ;
webcpp.drive cobalt_status : ../cobalt_status_test.cpp : <library>/webcpp/asio//cobalt
  : status_driver.py : : wasip2 ;
for local test in tls_client tls_client_embedded cobalt_tls_client cobalt_ssl_client
  cobalt_ssl_state cobalt_ssl_cancel
{
    local args ;
    local library = /webcpp/asio//tls ;
    if $(test) = cobalt_tls_client { library += /webcpp/asio//cobalt ; }
    if $(test) in cobalt_ssl_client cobalt_ssl_state cobalt_ssl_cancel
    { library = /webcpp/asio//cobalt_ssl ; }
    if $(test) != tls_client { args = --embedded ; }
    if $(test) = cobalt_ssl_client { args += --require-sni ; }
    if $(test) in cobalt_ssl_state cobalt_ssl_cancel { args = --state-test ; }
    webcpp.drive $(test) : ../../../../tools/openssl/test/$(test).cpp
      : <library>$(library) <webcpp-drive-timeout>180
        <dependency>../../../../tools/openssl/test/tls.py
      : tls_driver.py : $(args) : wasip2 ;
}
webcpp.lane wasip2-tls : entropy cobalt_status tls_client tls_client_embedded
  cobalt_tls_client cobalt_ssl_client cobalt_ssl_state cobalt_ssl_cancel : wasip2 ;
