  : <library>/webcpp/asio//tls
  : native wasip3 ;
# Hidden category singletons in the executable and shared object compare equal.
lib tls_error_peer : tls_error_peer.cpp
  : <link>shared <visibility>hidden <define>WEBCPP_TEST_ERROR_EXPORT
    <library>/webcpp/asio//tls ;
explicit tls_error_peer ;
webcpp.run tls_error_shared : tls_error_shared_test.cpp
  : <library>tls_error_peer <library>/webcpp/asio//tls <visibility>hidden : native ;
webcpp.headers-alone asio : ../include : asio/tls_client_context.hpp
  : <library>/webcpp/asio//tls : native wasip3 ;
webcpp.run tls_client_context_browser : tls_client_context_browser_test.cpp : : emscripten ;

