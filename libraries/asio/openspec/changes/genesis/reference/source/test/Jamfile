webcpp.run wasi_udp_gather : wasi_udp_gather_test.cpp : : native wasip3 ;
webcpp.run wasi_coroutine : wasi_coroutine_test.cpp : : native wasip3 ;
for local handling in on off
{
    webcpp.run asio_coroutine_exceptions_$(handling) : wasi_coroutine_test.cpp
      : <exception-handling>$(handling) : emscripten ;
    webcpp.run asio_coroutine_exceptions_$(handling)_asyncify : wasi_coroutine_test.cpp
      : <exception-handling>$(handling) <webcpp-suspend>asyncify : emscripten ;
    .asyncify += asio_coroutine_exceptions_$(handling)_asyncify ;
    webcpp.run cobalt_network_exceptions_$(handling) : cobalt_network_test.cpp
      : <library>/webcpp/asio//cobalt <exception-handling>$(handling) : native ;
}
