  : <library>/webcpp/asio//cobalt : native wasip3 ;
webcpp.run cobalt_wasi : cobalt_test.cpp : <library>/webcpp/asio//cobalt : wasip3 ;
# The SDK supports cooperative WASIp3 threads only with exceptions disabled.
