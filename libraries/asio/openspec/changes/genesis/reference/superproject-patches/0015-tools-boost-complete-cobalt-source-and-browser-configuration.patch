index 39d1a5d..721a065 100644
--- a/AGENTS.md
+++ b/AGENTS.md
@@ -322,6 +322,29 @@ being on the compiler's default include path, naming the `using boost` line to
 add, and if it lacks the library's sources; a build that needs none never
 looks.
 
+**Cobalt source target.** `/webcpp//boost_cobalt` builds a static library from
+24 of Boost 1.92's 26 Cobalt sources: `src/*.cpp`, `src/detail/*.cpp` and
+`src/io/*.cpp`, excluding `src/main.cpp` and `src/io/ssl.cpp`. It supplies no
+OpenSSL integration or default `co_main` runner; the webcpp runner belongs to
+the subsequent Asio integration task. Ordinary `main` consumers can use it now.
+Its sources define `BOOST_COBALT_SOURCE=1` and `BOOST_COBALT_IO_SOURCE=1`, while
+consumers receive `BOOST_COBALT_NO_LIB=1`. On Emscripten, both sources and
+consumers define `BOOST_ASIO_DISABLE_THREADS`; native thread support is unchanged.
+Use the shared `BOOST_SOURCE` setup above, not a separate Cobalt source tree.
+
+**Cobalt without exceptions.** A build that uses `/webcpp//boost_cobalt` with
+`exception-handling=off` emits a non-fatal configuration warning with
+https://github.com/boostorg/cobalt/issues/287 and recommends enabling exception
+handling. Boost 1.92 with libc++ can abort when a pending task is moved, including
+moves performed inside Cobalt. This warning describes a runtime risk; it does
+not claim to detect a move or prove a program safe. It appears once per distinct
+Cobalt build configuration in each b2 invocation, including dry runs, and never
+for an exceptions-enabled Cobalt configuration or an unrelated target. It does
+not change the exception setting or the build exit status. Compiler and lint
+warnings still follow their existing warnings-as-errors policies; a b2 warning
+is not a compiler diagnostic. Keep the warning until an upstream fix has been
+verified, rather than assuming a newer Boost release fixes the issue.
+
 **Machine-local setup.** `.local/` is git-ignored and holds what one machine
 needs: `.local/user-config.jam`, `.local/wasi-sdk/`, `.local/mrdocs/`,
 `.local/wit-bindgen/` and `.local/wasi-wit/p2` and `p3`, `.local/emsdk` (an
@@ -2868,7 +2891,8 @@ What webcpp does not have yet, and the chapters that mention it:
   Boost.Cobalt are built from Boost's sources (`/webcpp//boost_url`,
   `/webcpp//boost_charconv`, `/webcpp//boost_locale`, `/webcpp//boost_cobalt`).
   Boost.Locale requires exceptions. Boost.Cobalt follows the consumer's exception
-  setting without a blanket refusal. This is not a guarantee that all of Cobalt
+  setting with a non-fatal warning when disabled (chapter 1). This is not a
+  guarantee that all of Cobalt
   works without exceptions: in Boost 1.92, moving a pending task calls
   std::make_exception_ptr, which aborts with libc++ and -fno-exceptions, even
   when the application uses as_result. Eager promises and timer cancellation
diff --git a/tools/boost/Jamfile b/tools/boost/Jamfile
index 113f55d..fe8f040 100644
--- a/tools/boost/Jamfile
+++ b/tools/boost/Jamfile
@@ -9,12 +9,15 @@
 # program's own features, exception-handling=off among them, reach them. The
 # sources are the Jamroot's WEBCPP_BOOST_SOURCE, whose version the Jamroot's
 # alias of each library checks before anything is built: /webcpp//boost_url,
-# /webcpp//boost_charconv and /webcpp//boost_locale. They are Boost's code,
+# /webcpp//boost_charconv, /webcpp//boost_locale and /webcpp//boost_cobalt.
+# They are Boost's code,
 # not webcpp's, and compile without webcpp's warnings, as Boost's headers are
 # read as system ones.
 import errors ;
 import feature ;
+import property-set ;
 import sequence ;
+import set ;
 
 project /webcpp/boost-libraries
   : source-location $(WEBCPP_BOOST_SOURCE)
@@ -151,15 +154,15 @@ compiled boost_locale : $(.locale)
   : <define>BOOST_LOCALE_SOURCE <conditional>@locale-configuration
   : <define>BOOST_LOCALE_NO_LIB=1 <target-os>darwin:<library>iconv ;
 
-# Boost.Cobalt's sources without ssl.cpp, which needs OpenSSL, and which no
-# webcpp library uses yet.
+# Boost.Cobalt without its default co_main runner (main.cpp), which webcpp
+# supplies separately, and io/ssl.cpp, which needs OpenSSL.
 rule cobalt-sources ( )
 {
     local sources ;
     for local file in [ glob libs/cobalt/src/*.cpp libs/cobalt/src/detail/*.cpp
         libs/cobalt/src/io/*.cpp ]
     {
-        if ! [ MATCH "(^|/)ssl[.]cpp$" : $(file) ]
+        if ! [ MATCH "(^|/)(main|ssl)[.]cpp$" : $(file) ]
         {
             sources += $(file) ;
         }
@@ -167,13 +170,44 @@ rule cobalt-sources ( )
     return $(sources) ;
 }
 
+# This diagnostic is a configuration warning, not a compiler warning: even
+# warnings-as-errors=on must preserve the consumer's choice. Cache the
+# base configuration so several consumers of one archive do not repeat it.
+# b2 evaluates conditionals before and after applying library requirements;
+# ignore link and warning features, which this library fixes independently.
+rule cobalt-configuration ( properties * )
+{
+    if <exception-handling>off in $(properties)
+    {
+        local settings = [ property-set.create $(properties) ] ;
+        local base = [ $(settings).base ] ;
+        base = [ set.difference $(base) : <link>shared <link>static
+            <warnings>all <warnings>extra <warnings>off
+            <warnings-as-errors>on <warnings-as-errors>off ] ;
+        local key = $(base:J=|) ;
+        if ! $(.cobalt-warned.$(key))
+        {
+            .cobalt-warned.$(key) = true ;
+            ECHO "warning: webcpp: Boost.Cobalt is built with exceptions disabled;"
+                "moving a pending task can abort at runtime with libc++."
+                "Use exception-handling=on."
+                "See https://github.com/boostorg/cobalt/issues/287" ;
+        }
+    }
+}
+
 # Boost.Cobalt, with the macros of its own build: its sources see
-# BOOST_COBALT_SOURCE=1, and its users BOOST_COBALT_NO_LIB=1. Exception handling
+# BOOST_COBALT_SOURCE=1 and BOOST_COBALT_IO_SOURCE=1; users see
+# BOOST_COBALT_NO_LIB=1. Emscripten sources and users disable Asio threads
+# consistently, without changing native thread support. Exception handling
 # follows the consumer: result-based programs may disable it without a blanket
 # configuration refusal. This does not guarantee every Cobalt operation works
 # without exceptions: moving a pending task creates an exception_ptr in Boost
 # 1.92, which libc++ aborts on when built with -fno-exceptions.
 compiled boost_cobalt : [ cobalt-sources ]
   : libs/cobalt/src holds no .cpp file
-  : <define>BOOST_COBALT_SOURCE=1
-  : <define>BOOST_COBALT_NO_LIB=1 ;
+  : <define>BOOST_COBALT_SOURCE=1 <define>BOOST_COBALT_IO_SOURCE=1
+    <toolset>emscripten:<define>BOOST_ASIO_DISABLE_THREADS
+    <conditional>@cobalt-configuration
+  : <define>BOOST_COBALT_NO_LIB=1
+    <toolset>emscripten:<define>BOOST_ASIO_DISABLE_THREADS ;
