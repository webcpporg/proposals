project : requirements <library>/webcpp/beast//beast ;

import webcpp ;

webcpp.targets native wasip2 wasip3 emscripten ;

webcpp.headers-alone beast : ../include : beast.hpp beast/config.hpp
  beast/core.hpp beast/http.hpp ;
webcpp.compile config : config_test.cpp ;
webcpp.compile config_all_off : config_test.cpp
  : <define>WEBCPP_NO_EXCEPTIONS <define>WEBCPP_TEST_ALL_OFF ;
webcpp.compile config_developer_off : config_test.cpp
  : <define>WEBCPP_BEAST_NO_EXCEPTIONS <define>WEBCPP_TEST_DEVELOPER_OFF ;
webcpp.compile config_ignore : config_test.cpp : <webcpp-beast-unsupported>ignore ;
webcpp.compile-fail conflicting_policies : config_test.cpp
  : <define>WEBCPP_BEAST_UNSUPPORTED_ERROR <define>WEBCPP_BEAST_UNSUPPORTED_IGNORE ;

webcpp.run message : message_test.cpp ;

webcpp.headers-alone beast : ../include : beast/tcp_stream.hpp beast/websocket.hpp beast/http/read.hpp beast/http/write.hpp
  : <library>/webcpp/beast//sockets : native wasip3 ;
webcpp.run socket : socket_test.cpp : <library>/webcpp/beast//sockets : native wasip3 ;

webcpp.headers-alone beast : ../include : beast/ssl.hpp
  : <library>/webcpp/beast//tls : native wasip3 ;
webcpp.run ssl : ssl_test.cpp : <library>/webcpp/beast//tls : native wasip3 ;
